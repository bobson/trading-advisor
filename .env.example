# Copy this file to .env and fill in your key. .env is gitignored — never commit it.
# Only needed for Layer 2 (the Claude reasoning layer, Phase 7+). Phase 0/1 don't use it.
ANTHROPIC_API_KEY=

# Optional (Phase 21 context layer): economic calendar + news via Finnhub's free tier.
# Leave blank to run without them — crypto Fear & Greed (alternative.me) needs no key.
FINNHUB_API_KEY=

# Optional (Phase 26 forex): OHLC for forex pairs via Twelve Data's free tier.
# Leave blank to run crypto-only — forex pairs need this key.
TWELVEDATA_API_KEY=

# Optional (#7 alerts): a Discord/Slack-style incoming webhook URL. scripts/watch.py posts
# flagged setups here. Leave blank to just print them.
WEBHOOK_URL=

# #8 API lockdown — SET THESE BEFORE EXPOSING THE API PUBLICLY.
# API_KEY: when set, every data endpoint requires header  X-API-Key: <this>
# ALLOWED_ORIGINS: comma-separated origins allowed by CORS (your frontend URL)
# RATE_LIMIT_PER_MIN: per-client request cap (0 disables)
API_KEY=
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=60
